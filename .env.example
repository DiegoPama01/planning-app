# Django
DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me-local-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql://planning_user:planning_password@127.0.0.1:5432/planning_app?sslmode=disable&connect_timeout=5&conn_max_age=60
POSTGRES_DB=planning_app
POSTGRES_USER=planning_user
POSTGRES_PASSWORD=planning_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Authentik backend
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER_URL=http://localhost:9000/application/o/planning-app/
AUTHENTIK_DISCOVERY_URL=
AUTHENTIK_JWKS_URL=
AUTHENTIK_CLIENT_ID=planning-app
AUTHENTIK_CLIENT_SECRET=change-me-authentik-secret
AUTHENTIK_AUDIENCE=
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_SUB_CLAIM=sub
AUTHENTIK_EMAIL_CLAIM=email
AUTHENTIK_USERNAME_CLAIM=preferred_username
AUTHENTIK_VERIFY_SSL=true

# Frontend public runtime config
FRONTEND_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
FRONTEND_PUBLIC_AUTH_ENABLED=false
FRONTEND_PUBLIC_AUTH_ISSUER_URL=http://localhost:9000/application/o/planning-app/
FRONTEND_PUBLIC_AUTH_CLIENT_ID=planning-app
FRONTEND_PUBLIC_AUTH_REDIRECT_URI=http://localhost:4200
FRONTEND_PUBLIC_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:4200
FRONTEND_PUBLIC_AUTH_SCOPES=openid profile email
FRONTEND_PUBLIC_AUTH_RESPONSE_TYPE=code
