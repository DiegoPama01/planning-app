model
  schema 1.1

type user

type company
  relations
    define owner: [user]
    define admin: [user]
    define member: [user]

    define can_create_installation: owner or admin
    define can_manage_company: owner or admin

type installation
  relations
    define company: [company]

    define owner: [user]
    define admin: [user]
    define manager: [user]

    define can_manage: owner or admin
    define can_view_planning: owner or admin or manager
    define can_edit_planning: owner or admin or manager
